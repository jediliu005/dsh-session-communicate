{
  "name": "dsh-session-communicate",
  "version": "0.1.1",
  "type": "module",
  "description": "让两个已有 DSH 会话在每天固定时间按轮次对话：可配置双方会话、发起方、对话目的、轮次与时间；每一句都附带会话规则。",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "engines": {
    "node": ">=22.15"
  },
  "keywords": [
    "dsh",
    "plugin",
    "session",
    "conversation",
    "scheduler"
  ],
  "license": "MIT"
}
